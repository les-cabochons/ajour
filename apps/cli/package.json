{
  "name": "@ajour/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "ajour": "./src/main.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types --no-warnings src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit && node --experimental-strip-types --no-warnings scripts/build-man.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "node scripts/bundle.mjs",
    "sea": "node scripts/sea.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.24.2"
  }
}
