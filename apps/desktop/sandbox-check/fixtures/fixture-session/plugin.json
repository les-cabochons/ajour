{
  "id": "fixture-session",
  "version": "4.0.0",
  "apiVersion": 4,
  "displayName": "Fixture Session",
  "iconSvg": "<svg viewBox='0 0 16 16'><path d='M0 0h16v16H0z' /></svg>",
  "entrypoint": "plugin.mjs",
  "connectionFields": [
    { "id": "server", "label": "Server", "type": "text", "required": true },
    { "id": "session", "label": "Session", "type": "text" }
  ],
  "capabilities": { "connector": {} },
  "processes": {
    "executables": { "node": { "names": ["node"] } },
    "commands": [
      {
        "id": "rpc",
        "executable": "node",
        "args": ["{server:text}"],
        "mode": "session",
        "idleTimeoutSeconds": 60
      }
    ]
  }
}
